# Copy to .exoshell.local.toml in the caller's directory, or to
# $XDG_CONFIG_HOME/exoshell/exoshell.local.toml (default: ~/.config/exoshell/).
# Search order: --config PATH, caller's .exoshell.local.toml, user config above,
# then /etc/exoshell/exoshell.local.toml. --config accepts any filename and
# bypasses discovery; relative CLI paths use the caller's directory.
# Unset, empty, or relative XDG_CONFIG_HOME uses ~/.config. Absent candidates
# are skipped; invalid, unreadable, or non-file candidates are errors.
# Only one file is loaded; missing keys use built-in defaults, not other files.
# CLI options override settings. TOML paths are relative to this file.
# No launcher/project/parent lookup, uppercase aliases, or XDG_CONFIG_DIRS.
# A checkout config is discovered only when called from that checkout;
# callers elsewhere must pass --config or move it to the user config path.
# Adjust paths for this machine, especially if moving this file.
# Overlay users must supply --base-file explicitly; discovery does not set it.
image = "localhost/exoshell-local:latest"
host_share = "/home/you/src"
agent = "codex"

# Providers used by every agent.
# GWS initialization is automatic when its provider credentials are available.
providers = ["exoshell-github", "exoshell-gws"]
# Optionally add only the package registries this project needs:
# providers = ["exoshell-github", "exoshell-gws", "exoshell-npm-registry-ro", "exoshell-pypi-packages-ro", "exoshell-ghcr-registry-ro", "exoshell-dockerhub-registry-ro", "exoshell-quay-registry-ro"]
# Ubuntu APT repository access (system installs also need filesystem permissions):
# Add "exoshell-ubuntu-apt-ro" to the common providers array above.

# Optional integrations are disabled when omitted.
# policy = "policies/policy.yaml"
# kubeconfig = "/home/you/.kube/config"
# github_host = "github.example.com"
# gitlab_host = "gitlab.example.com"

[agents.codex]
providers = ["exoshell-codex"]
# model = "gpt-6-sol"
# effort = "medium" # Codex: model_reasoning_effort

[agents.claude]
providers = ["exoshell-claude-code"]
# model = "sonnet"
# effort = "high" # Claude Code: --effort

[agents.opencode]
providers = ["exoshell-opencode-openrouter"]
# model = "openrouter/example-model"
# effort = "high" # OpenCode: variant; requires model
