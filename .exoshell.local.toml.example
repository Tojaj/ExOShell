# Copy to .exoshell.local.toml and adjust paths for this machine.
image = "localhost/exoshell-local:latest"
host_share = "/home/you/src"
agent = "codex"

# Providers used by every agent.
# GWS initialization is automatic when its provider credentials are available.
providers = ["exoshell-github", "exoshell-gws"]
# Optionally add only the package registries this project needs:
# providers = ["exoshell-github", "exoshell-gws", "exoshell-npm-registry-ro", "exoshell-pypi-packages-ro", "exoshell-ghcr-registry-ro", "exoshell-dockerhub-registry-ro", "exoshell-quay-registry-ro"]

# Optional integrations are disabled when omitted.
# policy = "policies/policy.yaml"
# kubeconfig = "/home/you/.kube/config"
# github_host = "github.example.com"
# gitlab_host = "gitlab.example.com"

[agents.codex]
providers = ["exoshell-codex"]
# Add "exoshell-atlassian-mcp" after configuring the optional Atlassian integration.

[agents.claude]
providers = ["exoshell-claude-code"]
# Add "exoshell-atlassian-mcp" after configuring the optional Atlassian integration.

[agents.opencode]
providers = ["exoshell-opencode-openrouter"]
# Add "exoshell-atlassian-mcp" after configuring the optional Atlassian integration.
