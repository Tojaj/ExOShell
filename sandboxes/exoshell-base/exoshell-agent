#!/usr/bin/env python3
"""Start a command in a project, initializing provider-backed integrations."""

import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile


WORKSPACE = Path("/workspace")
GWS_DIR = Path("/tmp/gws")
GWS_KEYS = ("GWS_CLIENT_ID", "GWS_CLIENT_SECRET", "GWS_REFRESH_TOKEN")
ATLASSIAN_KEY = "ATLASSIAN_MCP_BEARER_TOKEN"
CLAUDE_MCP_TEMPLATE = Path("/etc/exoshell/claude-atlassian.json")
SKILLS_DIR = Path("/sandbox/.agents/skills")


def fail(message: str) -> None:
    print(f"exoshell-agent: {message}", file=sys.stderr)
    raise SystemExit(2)


def initialize_skills(environment: dict[str, str], destination: Path = SKILLS_DIR,
                      snapshot_path: Path = Path("/tmp/exoshell-skills")) -> None:
    """Copy the launcher snapshot once, preserving every existing image skill."""
    snapshot = environment.pop("EXOSHELL_SKILLS_SNAPSHOT", None)
    if snapshot is None:
        return
    try:
        if snapshot != str(snapshot_path):
            fail("invalid skill snapshot path")
        sources = sorted(Path(snapshot).iterdir())
        for source in sources:
            if source.is_symlink() or not source.is_dir() or not (source / "SKILL.md").is_file():
                fail(f"invalid skill snapshot entry: {source.name}")
            target = destination / source.name
            if target.exists() or target.is_symlink():
                fail(f"skill '{source.name}' conflicts with an existing sandbox skill")
        destination.mkdir(mode=0o700, parents=True, exist_ok=True)
        for source in sources:
            shutil.copytree(source, destination / source.name)
    except OSError as error:
        fail(f"could not import skills: {error}")


def object_field(config: dict, key: str) -> dict:
    value = config.setdefault(key, {})
    if not isinstance(value, dict):
        fail(f"MCP configuration field '{key}' must be an object")
    return value


def initialize_codex_auth(command: list[str], environment: dict[str, str], project: Path) -> None:
    """Cache the current provider credential before starting the Codex session."""
    credential = environment.get("OPENAI_API_KEY")
    if Path(command[0]).name != "codex" or not credential:
        return
    try:
        result = subprocess.run(
            [command[0], "login", "--with-api-key"],
            input=credential.encode("utf-8"), capture_output=True,
            env=environment, cwd=project,
        )
    except (OSError, UnicodeError):
        fail("could not initialize Codex API-key login")
    if result.returncode != 0:
        # Login diagnostics can contain credential material; never forward them.
        fail("could not initialize Codex API-key login")


def initialize_claude_mcp(environment: dict[str, str], project: Path, enabled: bool,
                          template: Path = CLAUDE_MCP_TEMPLATE) -> None:
    directory = Path(environment.get("CLAUDE_CONFIG_DIR") or
                     Path(environment.get("HOME", "/sandbox")) / ".claude").expanduser().resolve()
    target = directory / ".claude.json"
    temporary = None
    try:
        try:
            config = json.loads(target.read_text(encoding="utf-8"))
        except FileNotFoundError:
            config = {}
        if not isinstance(config, dict):
            fail("Claude MCP configuration must be an object")
        servers = object_field(config, "mcpServers")
        projects = object_field(config, "projects")
        state = object_field(projects, str(project))
        local_servers = object_field(state, "mcpServers")
        disabled = state.setdefault("disabledMcpServers", [])
        if not isinstance(disabled, list) or any(not isinstance(name, str) for name in disabled):
            fail("Claude disabledMcpServers must be a list of names")
        state["disabledMcpServers"] = [name for name in disabled if name != "atlassian"]
        if enabled:
            definition = json.loads(template.read_text(encoding="utf-8"))["mcpServers"]["atlassian"]
            if not isinstance(definition, dict):
                fail("Claude Atlassian MCP template must contain a server object")
            servers["atlassian"] = definition
            # Local scope wins over user and project scope. Own this name for
            # the selected project without changing unrelated MCP entries.
            local_servers["atlassian"] = definition
        else:
            servers.pop("atlassian", None)
            local_servers.pop("atlassian", None)
            state["disabledMcpServers"].append("atlassian")

        directory.mkdir(mode=0o700, parents=True, exist_ok=True)
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=directory, delete=False) as file:
            temporary = Path(file.name)
            os.fchmod(file.fileno(), 0o600)
            json.dump(config, file)
            file.write("\n")
            file.flush()
            os.fsync(file.fileno())
        os.replace(temporary, target)
    except (OSError, UnicodeError, ValueError, KeyError, TypeError):
        fail("could not prepare Claude MCP configuration")
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)
    environment["CLAUDE_CONFIG_DIR"] = str(directory)


def initialize_atlassian_mcp(command: list[str], environment: dict[str, str], project: Path) -> list[str]:
    """The credential placeholder, rather than an instance name, selects MCP."""
    agent = Path(command[0]).name
    enabled = bool(environment.get(ATLASSIAN_KEY))
    if agent == "codex":
        command = command.copy()
        # Put the managed leaf last so existing -c overrides cannot select a
        # different state. Keep a literal -- and its positional arguments intact.
        position = command.index("--") if "--" in command else len(command)
        command[position:position] = ["--config", f"mcp_servers.atlassian.enabled={str(enabled).lower()}"]
    elif agent == "opencode":
        try:
            config = json.loads(environment.get("OPENCODE_CONFIG_CONTENT") or "{}")
        except (ValueError, TypeError):
            fail("OPENCODE_CONFIG_CONTENT must be a JSON object")
        if not isinstance(config, dict):
            fail("OPENCODE_CONFIG_CONTENT must be a JSON object")
        servers = object_field(config, "mcp")
        server = object_field(servers, "atlassian")
        server["enabled"] = enabled
        environment["OPENCODE_CONFIG_CONTENT"] = json.dumps(config)
    elif agent == "claude":
        initialize_claude_mcp(environment, project, enabled)
    return command


def initialize_opencode_defaults(command: list[str], environment: dict[str, str]) -> None:
    """Merge interactive model/variant defaults into disposable inline config."""
    defaults_text = environment.pop("EXOSHELL_OPENCODE_DEFAULTS", None)
    if Path(command[0]).name != "opencode" or defaults_text is None:
        return
    try:
        defaults = json.loads(defaults_text)
        if (not isinstance(defaults, dict) or set(defaults) != {"model", "variant"}
                or any(not isinstance(value, str) or not value.strip() for value in defaults.values())):
            fail("EXOSHELL_OPENCODE_DEFAULTS must contain non-empty model and variant strings")
        config = json.loads(environment.get("OPENCODE_CONFIG_CONTENT") or "{}")
        if not isinstance(config, dict):
            fail("OPENCODE_CONFIG_CONTENT must be a JSON object")
        agents = object_field(config, "agent")
        for name in ("build", "plan"):
            object_field(agents, name).update(defaults)
        environment["OPENCODE_CONFIG_CONTENT"] = json.dumps(config)
    except (ValueError, TypeError):
        fail("could not prepare OpenCode model defaults")


def initialize_gws(environment: dict[str, str], directory: Path = GWS_DIR) -> None:
    """Initialize from provider credentials; a partial environment is an error."""
    if not any(environment.get(key) for key in GWS_KEYS):
        return
    missing = [key for key in GWS_KEYS if not environment.get(key)]
    if missing:
        fail(f"GWS requires non-empty environment values: {', '.join(missing)}")
    if not directory.is_dir():
        fail(f"GWS directory is missing: {directory} (provide a writable directory there)")

    config_dir = directory / "config"
    try:
        config_dir.mkdir(mode=0o700, exist_ok=True)
        if config_dir.is_symlink() or not config_dir.is_dir():
            fail("GWS config path is not a directory")
        config_dir.chmod(0o700)
    except OSError:
        fail("could not prepare private GWS config directory")

    credentials = {
        "type": "authorized_user",
        "client_id": environment["GWS_CLIENT_ID"],
        "client_secret": environment["GWS_CLIENT_SECRET"],
        "refresh_token": environment["GWS_REFRESH_TOKEN"],
    }
    target = directory / "credentials.json"
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=directory, delete=False) as file:
            temporary = Path(file.name)
            os.fchmod(file.fileno(), 0o600)
            json.dump(credentials, file)
            file.write("\n")
            file.flush()
            os.fsync(file.fileno())
        os.replace(temporary, target)
    except (OSError, UnicodeError):
        fail("could not write GWS credentials file")
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)

    environment["GOOGLE_WORKSPACE_CLI_CONFIG_DIR"] = str(config_dir)
    environment["GOOGLE_WORKSPACE_CLI_CREDENTIALS_FILE"] = str(target)


def main(arguments: list[str]) -> None:
    if len(arguments) < 3 or arguments[1] != "--":
        fail("usage: exoshell-agent PROJECT -- COMMAND [ARG ...]")
    project = Path(arguments[0])
    if not project.is_absolute():
        fail("PROJECT must be an absolute directory below /workspace")
    try:
        project = project.resolve(strict=True)
    except (OSError, RuntimeError):
        fail("PROJECT does not exist")
    if not project.is_dir() or not project.is_relative_to(WORKSPACE):
        fail("PROJECT must be a directory below /workspace")

    environment = os.environ.copy()
    initialize_skills(environment)
    initialize_opencode_defaults(arguments[2:], environment)
    command = initialize_atlassian_mcp(arguments[2:], environment, project)
    initialize_gws(environment)
    initialize_codex_auth(command, environment, project)
    try:
        os.chdir(project)
    except OSError:
        fail("could not enter PROJECT")
    try:
        os.execvpe(command[0], command, environment)
    except FileNotFoundError:
        fail(f"command not found: {arguments[2]}")
    except OSError:
        fail(f"could not start command: {arguments[2]}")


if __name__ == "__main__":
    main(sys.argv[1:])
